    mask=('[#1 ]', ), )))
mdb.models['ShellModel'].Material(name='MAT0')
mdb.models['ShellModel'].materials['MAT0'].Elastic(table=((69000.0, 0.33), ), 
    type=ISOTROPIC)
mdb.models['ShellModel'].materials['MAT0'].Density(table=((2.7e-09, ), ))
mdb.models['ShellModel'].HomogeneousShellSection(idealization=NO_IDEALIZATION, 
    integrationRule=SIMPSON, material='MAT0', name='Section', numIntPts=5, 
    poissonDefinition=DEFAULT, preIntegrate=OFF, thickness=0.1, thicknessType=
    UNIFORM)
mdb.models['ShellModel'].HomogeneousShellSection(idealization=NO_IDEALIZATION, 
    integrationRule=SIMPSON, material='MAT0', name='WebSection', numIntPts=5, 
    poissonDefinition=DEFAULT, preIntegrate=OFF, thickness=0.2, thicknessType=
    UNIFORM)
mdb.models['ShellModel'].parts['Shell'].SectionAssignment(offsetType=
